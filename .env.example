# Variables de entorno del Asistente de Supermercado (valores de EJEMPLO, no secretos).
# Copia este archivo como .env (ignorado por Git) y escribe tus valores reales solo allí.
# La aplicación lee variables de entorno del sistema: carga este archivo en tu sesión de PowerShell
# como se explica en el README antes de ejecutar el agente.

# Clave de Google AI Studio para Gemini (https://aistudio.google.com/apikey). Obligatoria para conversar.
GOOGLE_API_KEY=tu-clave-de-google-ai-studio

# Modelo Gemini (predeterminado; validado en la prueba conversacional real).
GEMINI_MODEL=gemini-3.6-flash

# Endpoint Streamable HTTP del servidor MCP del supermercado.
MCP_SERVER_URL=http://localhost:8088/mcp

# Tiempos de espera en segundos.
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_READ_TIMEOUT_SECONDS=30
MCP_NOTIFICATION_TIMEOUT_SECONDS=2
AGENT_RESPONSE_TIMEOUT_SECONDS=120

# Verificar al arrancar la API que el servidor MCP publique las diez herramientas (true/false).
MCP_VERIFY_ON_STARTUP=true

# Puerto de la API HTTP del asistente (POST /api/chat).
AGENT_PORT=8081
